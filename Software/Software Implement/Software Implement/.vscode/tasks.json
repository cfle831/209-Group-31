{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "build AVR project",
            "type": "shell",
            "command": "/usr/bin/avr-gcc",
            "args": [
                "-g",
                "-Os",
                "-mmcu=atmega328p", 
                "${file}",
                "-o",
                "${fileDirname}/${fileBasenameNoExtension}.elf"
            ],
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "problemMatcher": [
                "$gcc"
            ]
        }
    ]
}


